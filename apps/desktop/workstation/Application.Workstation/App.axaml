<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Application.Workstation.App"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Styles/DesignTokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <FontFamily x:Key="Font.UI">Inter, Segoe UI</FontFamily>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="{StaticResource Color.Action.Value}"
                               RegionColor="{StaticResource Color.Surface.Value}" ErrorText="{StaticResource Color.Danger.Value}" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="/Styles/Controls.axaml" />
  </Application.Styles>
</Application>
