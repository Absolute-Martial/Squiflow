<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Application.Workstation"
        x:Class="Application.Workstation.MainWindow" x:DataType="local:ConnectionViewModel"
        Title="{Binding ApplicationName}"
        Width="{StaticResource Size.WindowWidth}" Height="{StaticResource Size.WindowHeight}"
        MinWidth="{StaticResource Size.WindowMinWidth}" MinHeight="{StaticResource Size.WindowMinHeight}"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,*,Auto" Margin="{StaticResource Space.8.Horizontal}">
    <Border BorderBrush="{StaticResource Color.Line}" BorderThickness="{StaticResource Border.Thin.Bottom}"
            Padding="{StaticResource Space.6.Vertical}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space.4}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space.3}">
          <Border Background="{StaticResource Color.Action}" CornerRadius="{StaticResource Radius.Control.Corners}"
                  Width="{StaticResource Size.Control}" Height="{StaticResource Size.Control}">
            <Path Data="M7,17 L17,7 M7,7 L17,7 L17,17" Stroke="{StaticResource Color.Accent}"
                  StrokeThickness="{StaticResource Border.Focus}" Width="{StaticResource Size.Icon}"
                  Height="{StaticResource Size.Icon}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Grid.Column="1" Name="ApplicationNameText" Text="{Binding ApplicationName}"
                     FontSize="{StaticResource Font.Brand}" FontWeight="SemiBold"
                     VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
        </Grid>
        <TextBlock Grid.Column="1" Text="v0.0.1" Classes="eyebrow" VerticalAlignment="Center" />
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <Grid Name="EntryLayout" ColumnSpacing="{StaticResource Space.12}"
            Margin="{StaticResource Space.8.Vertical}" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="{StaticResource Size.Panel.Column}" />
        </Grid.ColumnDefinitions>
        <StackPanel Name="EntryIntroduction" Spacing="{StaticResource Space.6}" VerticalAlignment="Center">
          <TextBlock Text="YOUR WORKSPACE" Classes="eyebrow" />
          <StackPanel Spacing="{StaticResource Space.2}">
            <TextBlock Text="A clear start." Classes="page-title" />
            <TextBlock Text="Ready for your day." Classes="page-title" Foreground="{StaticResource Color.Muted}" />
          </StackPanel>
          <TextBlock Classes="copy" Text="Connect to your application service and check that everything is ready before you begin." />
          <Border BorderBrush="{StaticResource Color.Line}" BorderThickness="{StaticResource Border.Thin.Bottom}"
                  Padding="{StaticResource Space.6.Vertical}">
            <TextBlock Classes="copy" Text="Your work belongs to your workspace. Access is checked separately when you sign in." />
          </Border>
          <TextBlock Text="01  /  APPLICATION ENTRY" Classes="eyebrow" />
        </StackPanel>
        <Border Name="ConnectionPanel" Grid.Column="1" Classes="panel">
          <StackPanel Spacing="{StaticResource Space.5}">
            <TextBlock Text="CONNECTION" Classes="eyebrow" />
            <TextBlock Text="Your application service" Classes="section-title" />
            <TextBlock Classes="copy" Text="A live check of the service and its public application details." />
            <StackPanel Spacing="{StaticResource Space.2}">
              <Label Target="{Binding #ServiceAddressBox}" Content="Service address" />
              <TextBox Name="ServiceAddressBox" Text="{Binding Address, Mode=TwoWay}"
                       IsReadOnly="{Binding IsBusy}" MaxLength="2048" Watermark="https://app.example.com"
                       AutomationProperties.Name="Application service address" />
            </StackPanel>
            <Border Classes="status">
              <StackPanel Spacing="{StaticResource Space.2}">
                <TextBlock Name="ConnectionHeading" Text="{Binding Heading}" FontWeight="SemiBold"
                           FontSize="{StaticResource Font.Small}" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Name="ConnectionMessage" Text="{Binding Message}" Classes="copy" />
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding ConnectCommand.IsRunning}"
                             AutomationProperties.Name="Checking service connection" />
              </StackPanel>
            </Border>
            <StackPanel Spacing="{StaticResource Space.3}">
              <Button Name="ConnectButton" Classes="primary" Classes.busy="{Binding ConnectCommand.IsRunning}"
                      Content="Check connection" Command="{Binding ConnectCommand}" HorizontalAlignment="Stretch"
                      IsDefault="{Binding IsConnectionDefault}" AutomationProperties.Name="Check connection" />
              <Button Name="CancelButton" Content="Cancel check" Command="{Binding CancelCommand}"
                      IsVisible="{Binding ConnectCommand.IsRunning}" HorizontalAlignment="Stretch" />
            </StackPanel>
            <TextBlock Classes="caption" Text="Checking a connection does not create or change any business records." />
            <ContentControl Content="{Binding Access}" IsVisible="{Binding HasLogin}">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="local:TenantEntryViewModel"><local:TenantEntryPanel /></DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>
    <Border Grid.Row="2" BorderBrush="{StaticResource Color.Line}" BorderThickness="{StaticResource Border.Thin.Bottom}"
            Padding="{StaticResource Space.5.Vertical}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space.4}">
        <TextBlock Text="{Binding LegalName}" Classes="caption" />
        <TextBlock Grid.Column="1" Text="WORKSTATION" Classes="eyebrow" />
      </Grid>
    </Border>
  </Grid>
</Window>
