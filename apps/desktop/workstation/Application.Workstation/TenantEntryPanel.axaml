<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Application.Workstation" xmlns:entry="using:Application.ApplicationEntry"
             x:Class="Application.Workstation.TenantEntryPanel" x:DataType="local:TenantEntryViewModel">
  <StackPanel Spacing="{StaticResource Space.4}">
    <Border BorderBrush="{StaticResource Color.Line}" BorderThickness="{StaticResource Border.Thin.Bottom}"
            Padding="{StaticResource Space.4.Vertical}">
      <TextBlock Text="WORKSPACE ACCESS" Classes="eyebrow" />
    </Border>
    <TextBlock Name="AccessMessage" Text="{Binding Message}" Classes="copy" AutomationProperties.LiveSetting="Polite" />
    <Button Name="SignInButton" Content="Sign in with browser" Command="{Binding SignInCommand}" IsVisible="{Binding ShowSignIn}"
            Classes="primary" Classes.busy="{Binding SignInCommand.IsRunning}" HorizontalAlignment="Stretch" />
    <StackPanel IsVisible="{Binding ShowPicker}" Spacing="{StaticResource Space.3}">
      <Label Content="Workspace" Target="{Binding #TenantChoice}" />
      <ComboBox Name="TenantChoice" ItemsSource="{Binding Tenants}" SelectedItem="{Binding SelectedTenant, Mode=TwoWay}"
                PlaceholderText="Choose workspace" ToolTip.Tip="{Binding SelectedTenant.DisplayName}"
                HorizontalAlignment="Stretch" AutomationProperties.Name="Choose workspace" IsEnabled="{Binding IsIdle}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="entry:TenantEntry"><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" /></DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button Name="EnterWorkspaceButton" Content="Enter workspace" Command="{Binding EnterCommand}"
              IsDefault="{Binding ShowPicker}" Classes="primary" Classes.busy="{Binding EnterCommand.IsRunning}" HorizontalAlignment="Stretch" />
      <Button Content="Next workspaces" Command="{Binding NextCommand}" IsVisible="{Binding HasNextPage}" HorizontalAlignment="Stretch" />
      <Button Content="Reload first page" Command="{Binding RefreshCommand}" HorizontalAlignment="Stretch" />
    </StackPanel>
    <StackPanel IsVisible="{Binding HasWorkspace}" Spacing="{StaticResource Space.3}">
      <TextBlock Name="WorkspaceName" Text="{Binding WorkspaceName}" Classes="section-title" />
      <Button Content="Recheck access" Command="{Binding EnterCommand}" HorizontalAlignment="Stretch" />
      <Button Content="Switch workspace" Command="{Binding RefreshCommand}" HorizontalAlignment="Stretch" />
    </StackPanel>
    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" AutomationProperties.Name="Checking workspace access" />
    <Button Content="Cancel access check" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" HorizontalAlignment="Stretch" />
    <Button Content="Sign out" Command="{Binding SignOutCommand}" IsVisible="{Binding IsSignedIn}" HorizontalAlignment="Stretch" />
    <StackPanel Spacing="{StaticResource Space.1}" IsVisible="{Binding IsSignedIn}">
      <TextBlock Text="ACCOUNT REFERENCE" Classes="eyebrow" />
      <TextBlock Text="{Binding AccountReference}" Classes="caption" />
    </StackPanel>
  </StackPanel>
</UserControl>
