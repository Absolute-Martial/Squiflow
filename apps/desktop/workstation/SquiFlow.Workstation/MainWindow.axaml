<Window
    x:Class="SquiFlow.Workstation.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SquiFlow Workstation"
    Width="1180"
    Height="760"
    MinWidth="880"
    MinHeight="600">
  <Grid RowDefinitions="58,*,32" ColumnDefinitions="220,*">
    <Border Grid.ColumnSpan="2" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ThemeBorderLowBrush}" Padding="16,10">
      <Grid ColumnDefinitions="Auto,*,300,Auto" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="SquiFlow" FontSize="19" FontWeight="Bold" />
          <TextBlock Text="Phase-0 tenant" Opacity="0.58" VerticalAlignment="Center" />
        </StackPanel>
        <TextBox Grid.Column="2" Watermark="Search or run a command" IsEnabled="False" />
        <Border Grid.Column="3" Margin="14,0,0,0" Padding="8,4" CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource ThemeBorderLowBrush}">
          <TextBlock Text="Local foundation" FontSize="12" />
        </Border>
      </Grid>
    </Border>

    <Border Grid.Row="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource ThemeBorderLowBrush}" Padding="12,16">
      <StackPanel>
        <TextBlock Text="WORK" FontSize="11" Opacity="0.55" Margin="8,0,0,8" />
        <StackPanel x:Name="NavigationItems" />
      </StackPanel>
    </Border>

    <ContentControl x:Name="WorkspaceHost" Grid.Row="1" Grid.Column="1" />

    <Border Grid.Row="2" Grid.ColumnSpan="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ThemeBorderLowBrush}" Padding="12,5">
      <Grid ColumnDefinitions="Auto,20,Auto,20,*">
        <TextBlock Text="Local: ready" FontSize="12" />
        <TextBlock Grid.Column="2" Text="Server: not connected in Phase 0" FontSize="12" Opacity="0.72" />
        <TextBlock Grid.Column="4" Text="Pending sync: 0 · Conflicts: 0" HorizontalAlignment="Right" FontSize="12" Opacity="0.72" />
      </Grid>
    </Border>
  </Grid>
</Window>
