@page "/"
@rendermode Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer
@implements IDisposable
@inject ApplicationEntryClient Client
@inject Uri ServiceAddress
@inject IConfiguration Configuration

<PageTitle>@(check?.Application?.Brand.DisplayName ?? "Application connection")</PageTitle>
@if (check?.Application is { } identity)
{
    <HeadContent><link rel="icon" href="@identity.FaviconUrl" /></HeadContent>
}
<ApplicationShell Identity="check?.Application" MainClass="entry-main">
    <section class="intro" aria-labelledby="entry-title">
        <p class="eyebrow"><span class="small-rule" aria-hidden="true"></span> YOUR WORKSPACE</p>
        <h1 id="entry-title">A clear start.<br /><span>Ready for your day.</span></h1>
        <p class="intro-copy">Connect to your application service and check that everything is ready before you begin.</p>
        <div class="entry-note">
            <ArrowIcon />
            <p>Your work belongs to your workspace.<strong>Access is checked separately when you sign in.</strong></p>
        </div>
        <div class="intro-footer" aria-hidden="true"><span>01</span><span>APPLICATION ENTRY</span><span class="intro-footer-line"></span></div>
    </section>
    <section class="connection-panel" aria-labelledby="connection-title">
        <div class="panel-top"><span class="eyebrow">CONNECTION</span><ArrowIcon /></div>
        <h2 id="connection-title">Your application service</h2>
        <p class="panel-copy">A live check of the service and its public application details.</p>
        <div class="service-row">
            <span class="identity-label">Service address</span>
            <span class="service-address">@ServiceAddress.Authority</span>
        </div>
        <StatusMessage Tone="@(busy ? "neutral" : canceled ? "warning" : check?.Status == ConnectionStatus.Ready ? "ready" : check is null ? "neutral" : "error")"
                       Title="@(busy ? "Checking connection…" : canceled ? "Check canceled" : check?.Heading ?? "Connection not checked")"
                       Message="@(busy ? "Contacting your application service." : canceled ? "The connection check was canceled. Try again when you are ready." : check?.Message ?? "Check the service to get started.")" />
        @if (check?.Application is { } application && !busy)
        {
            <div class="application-identity">
                <span class="identity-label">Application</span>
                <strong>@application.Brand.DisplayName</strong>
                <span>@application.Brand.LegalName</span>
            </div>
        }
        <div class="panel-actions">
            @if (check?.Status == ConnectionStatus.Ready && Configuration.GetValue<bool>("Authentication:Enabled") && !busy)
            {
                <AuthorizeView>
                    <Authorized><a class="button" href="/workspace">Continue to workspace <ArrowIcon /></a></Authorized>
                    <NotAuthorized>
                        <form method="post" action="/auth/login" data-enhance="false">
                            <AntiforgeryToken />
                            <button class="button">Sign in <ArrowIcon /></button>
                        </form>
                    </NotAuthorized>
                </AuthorizeView>
            }
            <button class="button @(check?.Status == ConnectionStatus.Ready ? "button-secondary" : "")" @onclick="RefreshAsync"
                    disabled="@busy" aria-busy="@busy.ToString().ToLowerInvariant()">
                @(busy ? "Checking connection…" : "Check again") <ArrowIcon />
            </button>
            @if (busy)
            {
                <button class="cancel-button" @onclick="Cancel">Cancel check</button>
            }
        </div>
        <p class="check-caption">Checking a connection does not create or change any business records.</p>
    </section>
</ApplicationShell>

@code {
    private ConnectionCheck? check;
    private CancellationTokenSource? pending;
    private bool busy;
    private bool disposed;
    private bool canceled;

    protected override Task OnInitializedAsync() => RefreshAsync();

    private async Task RefreshAsync()
    {
        if (busy || disposed)
        {
            return;
        }

        busy = true;
        canceled = false;
        check = null;
        using var operation = new CancellationTokenSource();
        pending = operation;
        try
        {
            check = await Client.CheckAsync(ServiceAddress, operation.Token);
            operation.Token.ThrowIfCancellationRequested();
        }
        catch (OperationCanceledException) when (operation.IsCancellationRequested)
        {
            check = null;
            canceled = true;
        }
        finally
        {
            pending = null;
            busy = false;
        }
    }

    private void Cancel() => pending?.Cancel();

    public void Dispose()
    {
        disposed = true;
        pending?.Cancel();
        GC.SuppressFinalize(this);
    }
}
