@page "/workspace/{TenantId:guid}/purchasing"
@page "/workspace/{TenantId:guid}/purchasing/suppliers/{SupplierId:guid}"
@page "/workspace/{TenantId:guid}/purchasing/requests/{PurchaseId:guid}"
@attribute [Authorize]
@rendermode Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer
@inherits BusinessPage

<PageTitle>Purchasing</PageTitle>
<BusinessShell Identity="Identity" Workspace="Workspace" TenantId="TenantId" Active="purchasing" Busy="Busy" Message="@Message" Tone="@Tone">
    <div class="business-heading"><div><p class="eyebrow">SUPPLIER SERVICES</p><h1>Purchasing</h1></div><a class="cancel-button" href="@Root">Purchasing directory</a></div>
    <p class="panel-copy">Request a non-stock supplier service, record actual receipts and pay one receipt at a time. Supplier payments and refunds do not change customer balances, selling prices, stock or fulfillment. Each action checks its own current permission.</p>
    <PendingRequestNotice Command="PendingCommand" />
    @if (PendingCommand is not null) { <button class="button" disabled="@Busy" @onclick="RetryAsync">Retry saved request</button> }
    @if (receipt is { } saved)
    {
        <section class="status-box ready" aria-label="Purchasing command receipt"><div><h2>Purchasing request saved</h2><dl class="record-facts"><dt>Resource</dt><dd>@receiptKind</dd><dt>Saved reference</dt><dd>@saved.Id</dd><dt>Saved revision</dt><dd>@saved.Revision</dd></dl>
            <a class="cancel-button" href="@($"{Root}/{(receiptKind == "supplier" ? "suppliers" : "requests")}/{saved.Id:D}")">Load current saved record</a><p>Viewing needs separate permission. Load current records before reviewing balances or choosing a dependent receipt/payment.</p></div></section>
    }
    <div class="business-columns">
        <section class="business-panel" aria-labelledby="supplier-directory"><div class="section-toolbar"><h2 id="supplier-directory">Suppliers</h2><button class="cancel-button" disabled="@Locked" @onclick="() => SuppliersAsync(null)">Refresh suppliers</button></div>
            @if (suppliers is { } page) { @if (page.Items.Length == 0) { <p class="empty-state">No suppliers on this page. Supplier management is separately authorized below.</p> }<ul class="record-list">@foreach (var item in page.Items) { <li><a href="@($"{Root}/suppliers/{item.SupplierId:D}")">@item.Name <ArrowIcon /></a><span>@item.Status · Revision @item.Revision</span><span class="record-reference">@item.SupplierId</span></li> }</ul>@if (page.NextCursor is { } next) { <button class="cancel-button" disabled="@Locked" @onclick="() => SuppliersAsync(next)">Next suppliers</button> } }
            else if (!Busy) { <p class="empty-state">Load suppliers to check current viewing access.</p> }
        </section>
        <section class="business-panel" aria-labelledby="purchase-directory"><div class="section-toolbar"><h2 id="purchase-directory">Service requests</h2><button class="cancel-button" disabled="@Locked" @onclick="() => RequestsAsync(null)">Refresh service requests</button></div>
            @if (requests is { } requestPage) { @if (requestPage.Items.Length == 0) { <p class="empty-state">No service requests on this requestPage. A phone request can be recorded below without linking an Order.</p> }<ul class="record-list">@foreach (var item in requestPage.Items) { <li><a href="@($"{Root}/requests/{item.PurchaseId:D}")">@item.Description <ArrowIcon /></a><span>@item.Supplier.Name · Revision @item.Revision</span><span>@item.ReceivedQuantity / @item.RequestedQuantity @item.UnitCode received · @Money(item.OutstandingPayable) NPR outstanding</span></li> }</ul>@if (requestPage.NextCursor is { } next) { <button class="cancel-button" disabled="@Locked" @onclick="() => RequestsAsync(next)">Next service requests</button> } }
            else if (!Busy) { <p class="empty-state">Load service requests to check current viewing access.</p> }
        </section>
    </div>
    @if (supplier is { } selectedSupplier)
    {
        <section class="business-panel" aria-labelledby="supplier-current"><h2 id="supplier-current">Supplier: @selectedSupplier.Name</h2><dl class="record-facts"><dt>Reference</dt><dd>@selectedSupplier.SupplierId</dd><dt>Revision</dt><dd>@selectedSupplier.Revision</dd><dt>Status</dt><dd>@selectedSupplier.Status</dd><dt>Contact</dt><dd>@selectedSupplier.Contact</dd></dl></section>
    }
    <section class="business-panel" aria-labelledby="supplier-edit"><h2 id="supplier-edit">Supplier records</h2><p>Viewing and supplier management are separate permissions. Retirement prevents new requests and preserves existing financial history.</p>
        <fieldset class="business-form" disabled="@Locked"><legend class="visually-hidden">Supplier management</legend>
            <label for="supplier-id">Saved supplier reference</label><input id="supplier-id" maxlength="36" @bind="supplierReference" />
            <label for="supplier-revision">Expected supplier revision</label><input id="supplier-revision" type="number" min="1" step="1" @bind="supplierRevision" />
            <div class="panel-actions actions-inline"><button class="cancel-button" @onclick="LoadSupplierAsync">Load supplier</button><button class="cancel-button" @onclick="() => SupplierHistoryAsync(null)">Load supplier history</button><button class="cancel-button" @onclick="BalanceAsync">Load supplier balance</button></div>
            <label for="supplier-name">Supplier name</label><input id="supplier-name" maxlength="256" @bind="supplierName" />
            <label for="supplier-contact">Supplier contact (optional)</label><textarea id="supplier-contact" maxlength="1024" @bind="supplierContact"></textarea>
            <label class="check-field"><input type="checkbox" @bind="supplierReviewed" /> I reviewed this supplier name and contact.</label>
            <div class="panel-actions actions-inline"><button class="button" disabled="@(!supplierReviewed)" @onclick="() => SupplierSaveAsync(true)">Create supplier</button><button class="cancel-button" disabled="@(!supplierReviewed)" @onclick="() => SupplierSaveAsync(false)">Revise supplier</button></div>
            <details class="business-details"><summary>Retire supplier</summary><div class="business-form"><label for="supplier-retire">Type “Retire supplier” to confirm</label><input id="supplier-retire" autocomplete="off" @bind="retireConfirmation" @bind:event="oninput" /><button class="button button-danger" disabled='@(retireConfirmation != "Retire supplier")' @onclick="RetireAsync">Retire saved supplier</button></div></details>
        </fieldset>
        @if (balance is { } totals) { <h3>Supplier balance</h3><dl class="record-facts"><dt>Supplier reference</dt><dd>@totals.SupplierId</dd><dt>Actual receipt costs</dt><dd>@Money(totals.TotalCost) NPR</dd><dt>Payments</dt><dd>@Money(totals.PaidAmount) NPR</dd><dt>Actual refunds</dt><dd>@Money(totals.RefundedAmount) NPR</dd><dt>Outstanding payable</dt><dd>@Money(totals.OutstandingPayable) NPR</dd></dl><p>These supplier amounts are independent of customer settlement.</p> }
    </section>
    <section class="business-panel" aria-labelledby="purchase-create"><h2 id="purchase-create">Request a supplier service</h2><p>Requires request recording permission. The service checks the supplier, unit and any committed Order link. No stock or automatic fulfillment is created.</p>
        <fieldset class="business-form" disabled="@Locked"><legend class="visually-hidden">New supplier service request</legend>
            <label for="request-supplier">Request supplier reference</label><input id="request-supplier" maxlength="36" @bind="requestSupplier" />
            <label for="request-unit">Catalog unit reference</label><input id="request-unit" maxlength="36" @bind="requestUnit" />
            <label for="request-description">Supplier service description</label><textarea id="request-description" maxlength="1024" @bind="description"></textarea>
            <label for="request-quantity">Requested service quantity</label><input id="request-quantity" type="number" min="0.0001" step="any" @bind="requestQuantity" />
            <details class="business-details"><summary>Link one committed Order line (optional)</summary><div class="business-form"><label for="request-order">Linked committed Order reference (optional)</label><input id="request-order" maxlength="36" @bind="linkedOrder" /><label for="request-line">Linked Order line position</label><input id="request-line" type="number" min="1" step="1" @bind="linkedLine" /><label for="request-order-revision">Linked committed Order revision</label><input id="request-order-revision" type="number" min="1" step="1" @bind="linkedOrderRevision" /></div></details>
            <label class="check-field"><input type="checkbox" @bind="requestReviewed" /> I reviewed the supplier, unit, service quantity and optional Order link.</label><button class="button" disabled="@(!requestReviewed)" @onclick="RequestAsync">Save supplier service request</button>
        </fieldset>
    </section>
    @if (purchase is { } current)
    {
        <section class="business-panel" aria-labelledby="purchase-current"><h2 id="purchase-current">Current supplier service</h2><dl class="record-facts"><dt>Reference</dt><dd>@current.PurchaseId</dd><dt>Revision</dt><dd>@current.Revision</dd><dt>Supplier at request</dt><dd>@current.Supplier.Name</dd><dt>Service</dt><dd>@current.Description</dd><dt>Retained unit</dt><dd>@current.UnitCode · @current.UnitPrecision decimal places</dd><dt>Requested</dt><dd>@current.RequestedQuantity</dd><dt>Received</dt><dd>@current.ReceivedQuantity</dd><dt>Quantity still to receive</dt><dd>@current.RemainingQuantity</dd><dt>Cancelled remainder</dt><dd>@current.CancelledQuantity</dd><dt>Receipt cost</dt><dd>@Money(current.TotalCost) NPR</dd><dt>Paid</dt><dd>@Money(current.PaidAmount) NPR</dd><dt>Refunded</dt><dd>@Money(current.RefundedAmount) NPR</dd><dt>Outstanding payable</dt><dd>@Money(current.OutstandingPayable) NPR</dd>
                @if (current.Order is { } order) { <dt>Committed Order line</dt><dd>@order.OrderId · Line @order.LinePosition · Revision @order.OrderRevision</dd> }</dl>
            <h3>Receipts</h3><ul class="record-list">@foreach (var item in current.Receipts) { <li><strong>@item.Quantity @current.UnitCode · @Money(item.Cost) NPR · @(item.IsVoided ? "Voided" : "Effective")</strong><span class="record-reference">Receipt @item.EntryId</span><span class="record-reference">Effective event @item.EffectiveEventId</span></li> }</ul>
            <h3>Supplier payments</h3><ul class="record-list">@foreach (var item in current.Payments) { <li><strong>@Money(item.Amount) NPR · @item.Method · @(item.IsVoided ? "Voided" : "Effective")</strong><span class="record-reference">Payment @item.EntryId · Payable receipt @item.ReceiptId</span><span class="record-reference">Effective event @item.EffectiveEventId</span><span>@item.Reference</span></li> }</ul>
            <h3>Actual supplier refunds</h3><ul class="record-list">@foreach (var item in current.Refunds) { <li><strong>@Money(item.Amount) NPR · @item.Method · @(item.IsVoided ? "Voided" : "Effective")</strong><span class="record-reference">Refund @item.EntryId · Payment @item.PaymentId</span><span class="record-reference">Effective event @item.EffectiveEventId</span><span>@item.Reference</span></li> }</ul>
        </section>
    }
    <section class="business-panel" aria-labelledby="purchase-actions"><h2 id="purchase-actions">Record actual supplier activity</h2><p>Receipt recording, payment recording, request cancellation and correction each check their own authority. NPR amounts use exactly two decimal places or fewer, without rounding.</p>
        <fieldset class="business-form" disabled="@Locked"><legend class="visually-hidden">Supplier service activity</legend>
            <label for="purchase-id">Saved service request reference</label><input id="purchase-id" maxlength="36" @bind="purchaseReference" />
            <label for="purchase-revision">Expected service request revision</label><input id="purchase-revision" type="number" min="1" step="1" @bind="purchaseRevision" />
            <div class="panel-actions actions-inline"><button class="cancel-button" @onclick="LoadPurchaseAsync">Load service request</button><button class="cancel-button" @onclick="() => PurchaseHistoryAsync(null)">Load supplier service history</button></div>
            <details class="business-details"><summary>Record actual service receipt</summary><div class="business-form">
                <label for="receive-quantity">Actual received quantity</label><input id="receive-quantity" type="number" min="0.0001" step="any" @bind="receiveQuantity" />
                <label for="receive-cost">Actual receipt total cost (NPR)</label><input id="receive-cost" type="number" min="0.01" step="0.01" @bind="receiveCost" />
                <label class="check-field"><input type="checkbox" @bind="receiptReviewed" /> I reviewed the actual received quantity and its total cost.</label><button class="button" disabled="@(!receiptReviewed)" @onclick="ReceiveAsync">Record supplier receipt</button>
            </div></details>
            <details class="business-details"><summary>Record payment to supplier</summary><div class="business-form"><p>Allocate one actual payment to one receipt payable. Load current receipts above to obtain the exact reference.</p>
                <label for="pay-receipt">Payable receipt reference</label><input id="pay-receipt" maxlength="36" @bind="payableReceipt" /><label for="pay-amount">Actual supplier payment amount (NPR)</label><input id="pay-amount" type="number" min="0.01" step="0.01" @bind="paymentAmount" />
                <label for="pay-method">Supplier payment method</label><select id="pay-method" @bind="paymentMethod"><option>Cash</option><option>Bank</option></select><label for="pay-reference">Supplier payment reference (optional)</label><input id="pay-reference" maxlength="256" @bind="paymentReference" />
                <label class="check-field"><input type="checkbox" @bind="paymentReviewed" /> I reviewed this actual payment and exact receipt payable.</label><button class="button" disabled="@(!paymentReviewed)" @onclick="() => PayAsync(false)">Record supplier payment</button>
            </div></details>
            <details class="business-details"><summary>Record actual supplier refund</summary><div class="business-form"><p>Record money actually received back from the supplier and link it to the original payment. A correction alone does not record a refund.</p>
                <label for="refund-payment">Original supplier payment reference</label><input id="refund-payment" maxlength="36" @bind="refundPayment" /><label for="refund-amount">Actual supplier refund amount (NPR)</label><input id="refund-amount" type="number" min="0.01" step="0.01" @bind="refundAmount" />
                <label for="refund-method">Supplier refund method</label><select id="refund-method" @bind="refundMethod"><option>Cash</option><option>Bank</option></select><label for="refund-reference">Supplier refund reference (optional)</label><input id="refund-reference" maxlength="256" @bind="refundReference" />
                <label class="check-field"><input type="checkbox" @bind="refundReviewed" /> I reviewed the actual refund received and original supplier payment.</label><button class="button" disabled="@(!refundReviewed)" @onclick="() => PayAsync(true)">Record supplier refund</button>
            </div></details>
            <details class="business-details"><summary>Cancel unreceived remainder</summary><div class="business-form"><p>Requires request recording permission. Existing receipts and payable facts remain. This does not prove supplier-side contractual cancellation.</p><label for="purchase-cancel-reason">Cancellation reason</label><textarea id="purchase-cancel-reason" maxlength="1024" @bind="cancelReason"></textarea><label for="purchase-cancel-confirm">Type “Cancel remainder” to confirm</label><input id="purchase-cancel-confirm" autocomplete="off" @bind="cancelConfirmation" @bind:event="oninput" /><button class="button button-danger" disabled='@(cancelConfirmation != "Cancel remainder")' @onclick="CancelAsync">Cancel unreceived quantity</button></div></details>
            <details class="business-details"><summary>Correct supplier financial entry</summary><div class="business-form"><p>Requires the current initial Owner, separate correction permission and recent trusted strong authentication. The original fact remains. The service checks dependent payments/refunds and current payable amounts.</p>
                @if (VerificationAvailable) { <form method="post" action="/auth/verify-identity" data-enhance="false"><AntiforgeryToken /><input type="hidden" name="tenantId" value="@TenantId" /><button class="cancel-button" type="submit">Verify identity for purchasing correction</button></form><p>Verification starts a fresh sign-in and returns to Billing. Return to Purchasing from workspace navigation. Unsent entries are lost; resolve saved requests first.</p> }
                else { <p>Fresh identity verification is unavailable until your administrator configures it.</p> }
                <label for="purchase-correct-target">Supplier service event reference to correct</label><input id="purchase-correct-target" maxlength="36" @bind="correctionTarget" />
                <label for="purchase-correct-reason">Supplier financial correction reason</label><textarea id="purchase-correct-reason" maxlength="1024" @bind="correctionReason"></textarea>
                <label for="purchase-replacement">Replacement supplier fact</label><select id="purchase-replacement" @bind="replacementKind"><option value="None">Void mistaken entry without replacement</option><option>Receipt</option><option>Payment</option><option>Refund</option></select>
                @if (replacementKind != "None") { @if (replacementKind == "Receipt") { <label for="purchase-replace-quantity">Replacement received quantity</label><input id="purchase-replace-quantity" type="number" min="0.0001" step="any" @bind="replacementQuantity" /> }<label for="purchase-replace-amount">Replacement amount or receipt cost (NPR)</label><input id="purchase-replace-amount" type="number" min="0.01" step="0.01" @bind="replacementAmount" />
                    @if (replacementKind == "Payment") { <label for="purchase-replace-receipt">Replacement payable receipt reference</label><input id="purchase-replace-receipt" maxlength="36" @bind="replacementReceipt" /> }
                    @if (replacementKind == "Refund") { <label for="purchase-replace-payment">Replacement original payment reference</label><input id="purchase-replace-payment" maxlength="36" @bind="replacementPayment" /> }
                    @if (replacementKind != "Receipt") { <label for="purchase-replace-method">Replacement payment method</label><select id="purchase-replace-method" @bind="replacementMethod"><option>Cash</option><option>Bank</option></select><label for="purchase-replace-reference">Replacement payment reference (optional)</label><input id="purchase-replace-reference" maxlength="256" @bind="replacementReference" /> }
                }
                <label for="purchase-correct-confirm">Type “Correct supplier entry” to confirm</label><input id="purchase-correct-confirm" autocomplete="off" @bind="correctionConfirmation" @bind:event="oninput" /><button class="button button-danger" disabled='@(correctionConfirmation != "Correct supplier entry")' @onclick="CorrectAsync">Correct supplier entry</button>
            </div></details>
        </fieldset>
    </section>
    @if (supplierHistory is { } supplierEvents) { <section class="business-panel" aria-labelledby="supplier-history"><h2 id="supplier-history">Protected supplier history</h2><p>Observed revision @supplierEvents.ObservedRevision</p><ol class="record-list">@foreach (var item in supplierEvents.Items) { <li><strong>Revision @item.Revision · @item.Kind · @item.Supplier.Status</strong><span>@item.Supplier.Name · @item.Supplier.Contact</span><span class="record-reference">Event @item.EventId · Actor @item.ActorAccountId · @item.RecordedAt.ToString("u")</span></li> }</ol>@if (supplierEvents.NextRevision is { } next) { <button class="cancel-button" disabled="@Locked" @onclick="() => SupplierHistoryAsync(next)">Earlier supplier events</button> }</section> }
    @if (purchaseHistory is { } purchaseEvents) { <section class="business-panel" aria-labelledby="purchase-history"><h2 id="purchase-history">Protected supplier service history</h2><p>Observed revision @purchaseEvents.ObservedRevision</p><ol class="record-list">@foreach (var item in purchaseEvents.Items) { <li><strong>Revision @item.Revision · @item.Kind</strong><span class="record-reference">Event @item.EventId · Actor @item.ActorAccountId · @item.RecordedAt.ToString("u")</span><span>@item.Reason</span>
                @if (item.Facts is { } fact) { <span>@fact.Kind · Quantity @fact.Quantity · NPR @fact.Amount · @fact.Method · @fact.Reference</span><span class="record-reference">Receipt @fact.ReceiptId · Payment @fact.PaymentId</span> }
                @if (item.TargetEventId is { } target) { <span class="record-reference">Corrects @target</span> }
                @if (item.Replacement is { } replacement) { <span>Replacement @replacement.Kind · Quantity @replacement.Quantity · NPR @replacement.Amount · @replacement.Method · @replacement.Reference</span><span class="record-reference">Receipt @replacement.ReceiptId · Payment @replacement.PaymentId</span> }</li> }</ol>@if (purchaseEvents.NextRevision is { } next) { <button class="cancel-button" disabled="@Locked" @onclick="() => PurchaseHistoryAsync(next)">Earlier supplier service events</button> }</section> }
</BusinessShell>
