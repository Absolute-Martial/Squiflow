<UserControl
    x:Class="SquiFlow.Customers.Workstation.CustomerWorkspaceView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid RowDefinitions="Auto,*" Margin="24">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,18">
      <StackPanel Spacing="4">
        <TextBlock Text="Customers" FontSize="28" FontWeight="SemiBold" />
        <TextBlock Text="Local-first customer workspace" Opacity="0.68" />
      </StackPanel>
      <Button Grid.Column="1" Content="New customer" IsEnabled="False" ToolTip.Tip="Enabled in the Phase-2 local-data slice." />
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="2*,*" ColumnSpacing="16">
      <Border BorderThickness="1" BorderBrush="{DynamicResource ThemeBorderLowBrush}" CornerRadius="8" Padding="18">
        <StackPanel Spacing="14">
          <TextBox Watermark="Search customers" IsEnabled="False" />
          <TextBlock Text="No local customer data yet." FontSize="18" FontWeight="SemiBold" />
          <TextBlock TextWrapping="Wrap"
                     Text="This Phase-0 workspace proves module-owned Avalonia composition without fake dashboard data. SQLite-backed customer capture arrives in Phase 2." />
        </StackPanel>
      </Border>

      <Border Grid.Column="1" BorderThickness="1" BorderBrush="{DynamicResource ThemeBorderLowBrush}" CornerRadius="8" Padding="18">
        <StackPanel Spacing="8">
          <TextBlock Text="Context" FontWeight="SemiBold" />
          <TextBlock TextWrapping="Wrap" Opacity="0.72"
                     Text="Select a customer later to inspect authoritative/local state, pending sync, conflicts, and permitted actions." />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
