\set ON_ERROR_STOP on
\if :{?runtime_role}
\else
\echo 'Pass an existing Admin bootstrap role with -v runtime_role=...'
DO $$ BEGIN RAISE EXCEPTION 'Admin bootstrap runtime role was not supplied'; END $$;
\endif

BEGIN;
SELECT set_config('app.provision_admin_bootstrap_role', :'runtime_role', true);
\ir grant-admin-bootstrap.sql
COMMIT;
