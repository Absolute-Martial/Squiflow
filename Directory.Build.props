<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <IsPackable>false</IsPackable>
    <LockedProductVersion>0.1.0</LockedProductVersion>
    <Version>$(LockedProductVersion)</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>$(LockedProductVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
    <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
    <Authors />
    <Company />
    <Product />
    <Title />
    <RepositoryUrl />
  </PropertyGroup>

  <Target Name="ValidateLockedProductVersion" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Version)' != '$(LockedProductVersion)'"
           Text="Product version is locked to $(LockedProductVersion) until the production-capable product gate is explicitly qualified." />
    <Error Condition="'$(AssemblyVersion)' != '0.1.0.0'"
           Text="AssemblyVersion is locked to 0.1.0.0 until the production-capable product gate is explicitly qualified." />
    <Error Condition="'$(FileVersion)' != '0.1.0.0'"
           Text="FileVersion is locked to 0.1.0.0 until the production-capable product gate is explicitly qualified." />
    <Error Condition="'$(InformationalVersion)' != '$(LockedProductVersion)'"
           Text="InformationalVersion is locked to $(LockedProductVersion) until the production-capable product gate is explicitly qualified." />
  </Target>
</Project>
